# ==============================================================================
# ecotech-backend: variáveis de ambiente
# Copie para `.env` e preencha. O `.env` nunca vai para o git.
# ==============================================================================

# --- Banco de dados -----------------------------------------------------------
# Com o docker-compose.yml deste diretório:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecotech?schema=public

# --- Aplicação ----------------------------------------------------------------
# O frontend usa VITE_API_URL=http://localhost:3333
PORT=3333
# Origens liberadas no CORS, separadas por vírgula (o Vite usa 5173).
CORS_ORIGIN=http://localhost:5173

# --- Rate limit (por IP) --------------------------------------------------------
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300

# --- JWT ----------------------------------------------------------------------
# Strings longas e aleatórias (ex: `openssl rand -hex 32`), diferentes entre si.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Água ---------------------------------------------------------------------
# Tarifa usada no custo e na economia dos relatórios (R$ por m³). Padrão: 6.48.
WATER_TARIFF_PER_M3=6.48
